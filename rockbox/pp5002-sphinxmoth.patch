+/* IDE controller cycle timing.
+ *
+ * The retail firmware (1G/2G 1.1.5 osos) does not use one fixed setting; it
+ * picks the pair of timing registers, and bit 2 of the config register, from
+ * the current clock configuration. 0x10 / 0x80002150 is only one entry of
+ * that table (iPodLinux copied it as a constant, and Rockbox inherited it).
+ *
+ * With an original drive any of these work. With flash storage behind a
+ * bridge that adds latency on the read side, 0x10 at 80 MHz makes taskfile
+ * readback fail (ATA error -32), while the retail's 80 MHz entry works.
+ * Conversely the 80 MHz entry does not work at 30 MHz. So follow the retail
+ * firmware and select by clock.
+ *
+ * Verified on an iPod 2G with a MachXO2 CF bridge and both an FC1307A
+ * SD-to-CF adapter and a genuine CF card:
+ *   30 MHz: 0x10   / 0x80002150, cfg bit 2 clear
+ *   80 MHz: 0x11c1 / 0x80003261, cfg bit 2 set
+ * The retail table has two further entries (0x4121 / 0x8000ffff and
+ * 0x1181 / 0x8000ffff) whose clock keys were not decoded.
+ */
+#define IDE_TIMING0     (*(volatile unsigned long *)(0xc0003000))
+#define IDE_TIMING1     (*(volatile unsigned long *)(0xc0003004))
+
+void ata_set_bus_timings(long frequency)
+{
+    unsigned long cfg = IDE_CFG_STATUS & ~(1 << 2);
+
+    if (frequency == CPUFREQ_MAX)
+    {
+        IDE_TIMING0 = 0x11c1;
+        IDE_TIMING1 = 0x80003261;
+        cfg |= (1 << 2);
+    }
+    else
+    {
+        IDE_TIMING0 = 0x10;
+        IDE_TIMING1 = 0x80002150;
+    }
+
+    IDE_CFG_STATUS = cfg;
+}
 
